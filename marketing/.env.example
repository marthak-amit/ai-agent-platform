# Base URL of the dashboard SPA (frontend/). Used for "Log in" and
# "Create your account" links — these are external links to the separate
# dashboard app, not routes on this marketing site. For local dev, point at
# the dashboard's dev server (frontend/, runs on :3000 per its Dockerfile);
# for prod, use the real deployed dashboard domain.
VITE_DASHBOARD_URL=http://localhost:3000

# Base URL of the FastAPI backend (backend/). Used for POST /leads/public on
# the Book a Demo form. Falls back to localhost:8000 if unset.
VITE_API_URL=http://localhost:8000

# Calendly scheduling link embedded inline on /demo. Falls back to the
# AgentlyAI default below if unset.
VITE_CALENDLY_URL=https://calendly.com/amit-marthak03/30min
