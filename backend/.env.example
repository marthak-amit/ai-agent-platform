# ─────────────────────────────────────────────────────────────────
# AI Agent Platform — Environment Variables
#
# Copy this file to .env and fill in real values before running.
# Never commit .env — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# asyncpg driver is added automatically; write plain postgresql:// here.
DATABASE_URL=postgresql://user:password@localhost:5432/ai_agent_db

# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq — all conversational replies, classifiers and vision run here.
GROQ_API_KEY=
# Model ids (defaults live in app/config.py). Verify what your key can use with:
#   python scripts/check_llm_models.py
# LLM_MODEL_VISION= (empty) disables the image-matching path.
# The old CLASSIFY_MODEL / REPLY_MODEL variables are no longer read — delete them.
# LLM_MODEL_REPLY=
# LLM_MODEL_CLASSIFIER=
# LLM_MODEL_VISION=
# LLM_MODEL_STT=
# LLM_MODEL_REPLY_FALLBACKS=

# Google Gemini API key — no longer used, kept for reference
GEMINI_API_KEY=

# Meta / WhatsApp Cloud API — Meta Developer Console → App → WhatsApp → Configuration
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Instagram (optional — only needed for Growth / Pro plan features)
# Per-client tokens live on clients.instagram_access_token (checked at startup via graph.instagram.com/me,
# refreshed weekly). This global token is only a fallback still used by IG sends / media download.
INSTAGRAM_ACCESS_TOKEN=

# Meta app credentials for the self-serve "Connect Instagram" OAuth flow
# (Meta Developer Console → App → Settings → Basic). META_APP_SECRET above
# is reused as the OAuth client secret — do not duplicate it.
META_APP_ID=
META_OAUTH_REDIRECT_URI=https://api.yourdomain.com/integrations/instagram/callback
# Scopes requested during the OAuth flow (Facebook Login for Business):
# instagram_basic, instagram_manage_messages, pages_show_list, pages_manage_metadata

# Razorpay (optional — only needed for payment features)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- SellerTalk24 billing (Razorpay Orders API + Checkout.js; prepaid, manual renew) ---
# Signs webhooks. Razorpay Dashboard -> Account & Settings -> Webhooks -> your endpoint's
# "Secret". This is NOT RAZORPAY_KEY_SECRET. Webhooks are rejected while it is empty.
RAZORPAY_WEBHOOK_SECRET=
# "auto" (default): the keys decide — rzp_test_... = test payments, rzp_live_... = real payments.
# Optionally lock it to "test" or "live": a key with the other prefix is then refused, and
# mock billing is NEVER allowed when this is "live" (use that on production).
RAZORPAY_MODE=auto
# Mock gateway (fake order/payment ids, real HMAC signatures, no network). Leave the line
# commented for AUTO: mock is on while RAZORPAY_KEY_ID/RAZORPAY_KEY_SECRET are empty.
# Set true/false to force it. (Do not leave it as an empty "SELLERTALK24_BILLING_MOCK=".)
# SELLERTALK24_BILLING_MOCK=true
# Are the prices in billing_plans GST-inclusive? We list them EXCLUSIVE ("Rs 4,599 + GST"),
# so keep this false. true = back-calculate GST out of the listed price instead.
PRICES_INCLUDE_GST=false
# GST rate in basis points (1800 = 18%).
GST_RATE_BPS=1800
# Seller GST state code (24 = Gujarat). Same-state buyers pay CGST+SGST, others IGST.
SELLER_STATE_CODE=24
# Days of full service after a plan lapses (or after signup if never subscribed). Bot works, red banner.
GRACE_DAYS=3
# Hard stop for clients with NO plan past grace: new customers get a fixed "temporarily unavailable"
# reply (orders already in progress still complete). OFF by default so deploying billing cannot
# silence existing clients; turn on once they have subscribed or are marked billing_exempt.
SELLERTALK24_BILLING_ENFORCE=false
# Run the old calendar-month conversation counter alongside the new one for one release (logs both).
BILLING_LEGACY_COUNTING=true

# This backend's own public HTTPS URL (e.g. Railway's assigned domain).
# Used to build fully-qualified invoice PDF links that WhatsApp's API can
# fetch. Leave unset in local dev — invoice documents just won't be
# fetchable by WhatsApp until this is set.
BACKEND_PUBLIC_URL=

# Public base URL of the hosted shop/catalogue pages, used in customer-facing
# catalogue links (legacy name CATALOGUE_BASE_URL is still read as a fallback).
PUBLIC_SHOP_BASE_URL=https://agentlyai.in/shop

# JWT signing secret — use a long random string in production. The app REFUSES
# TO START if ENVIRONMENT != development and this is still the default.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Admin panel key — sent as X-Admin-Key header to /admin/* endpoints
ADMIN_SECRET_KEY=change-me-admin-secret

# AgentlyAI team's own WhatsApp number (E.164, no '+'), e.g. 919876543210.
# Notified on new "Book a Demo" leads from the marketing site. Leave unset
# to skip the notification entirely — the lead is still saved either way.
INTERNAL_LEAD_NOTIFY_NUMBER=

# Cloudflare R2 (S3-compatible) — product/catalogue image storage.
# Dashboard: https://dash.cloudflare.com → R2 Object Storage
# Leave unset to fall back to local disk storage in dev.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
# Public base URL for the bucket once public access is enabled (bucket →
# Settings → Public access → either the r2.dev URL or a connected custom
# domain), e.g. https://pub-xxxx.r2.dev or https://media.yourdomain.com.
# Required for uploaded images to be fetchable by WhatsApp/Instagram.
R2_PUBLIC_BASE_URL=

# LLM cost tracking (llm_usage table). USD_INR is REQUIRED (no default in code: the app will not start without it).
# Prices are USD per 1M tokens as [input, cached_input, output] — verify against the provider's pricing page.
# Models not listed use the default rate.
USD_INR=83
# LLM_PRICE_USD_PER_1M={"openai/gpt-oss-20b": [0.075, 0.0375, 0.30]}
# LLM_STT_USD_PER_HOUR=0.04

# LLM intent router (ROUTER_V2): front door for non-slot messages. Which clients it is ON for
# when Client.router_v2_enabled is NULL: comma-separated client ids, "*" = all, empty = none.
# ROUTER_V2_CLIENT_IDS=1
# ROUTER_CONFIDENCE_THRESHOLD=0.5

# SellerTalk24 tax invoices (printed on every PDF). SELLER_STATE_CODE (24 = Gujarat) decides CGST+SGST vs IGST.
# SELLER_LEGAL_NAME=SellerTalk24
# SELLER_GSTIN=
# SELLER_ADDRESS=
# SELLER_STATE_NAME=Gujarat
# INVOICE_PREFIX=ST24

# Operator inbox for billing incidents: amount mismatch, >5 bad webhook signatures in 10 min, an order the
# reconcile job had to activate. Empty = only logged at ERROR. Uses EMAIL_PROVIDER below (console = log only).
# BILLING_ALERT_EMAIL=
# Billing emails: EMAIL_PROVIDER=console (log only, default) | smtp
# EMAIL_PROVIDER=console
# EMAIL_FROM=SellerTalk24 <billing@sellertalk24.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# Dashboard-first onboarding -------------------------------------------------------------------------------
# "Continue with Google": OAuth 2.0 *Web* client id from the SellerTalk24 Google Cloud project (Credentials ->
# Create credentials -> OAuth client ID -> Web application; Authorised JavaScript origins = the dashboard origin(s)).
# Empty = the button is hidden and POST /auth/google answers 503. The consent screen's app name / logo / domain
# are configured on that project's OAuth consent screen (no Firebase is involved).
# GOOGLE_CLIENT_ID=
# Free trial: starts at "Go live" (never at signup); ends at whichever limit comes first, then GRACE_DAYS of grace.
# One trial per WhatsApp phone_number_id. Enforced like every other expiry: only when SELLERTALK24_BILLING_ENFORCE=true.
# TRIAL_DAYS=7
# TRIAL_CONVERSATION_LIMIT=100
# In-dashboard chat simulator: max customer messages per client per UTC day. 0 (default) = unlimited — but every
# simulator turn runs the real LLM, so set a cap if free accounts could abuse it.
# SIMULATOR_DAILY_MESSAGE_LIMIT=0

# Chat-flow hardening (see CLAUDE.md "Cancel Safety, Confusion & Draft Restore")
# A cancelled order draft can be restored by "continue"/"yes" for this long; an open "Cancel this order?" waits this long.
# DRAFT_RESTORE_TTL_MINUTES=30
# CANCEL_CONFIRM_TTL_MINUTES=10
# A router cancel_order needs explicit cancel wording AND at least this confidence to cancel without asking.
# ROUTER_CANCEL_MIN_CONFIDENCE=0.95
# Orders above this total need the seller's explicit review before payment approval (Client.high_value_order_threshold overrides).
# HIGH_VALUE_ORDER_THRESHOLD=50000

# Agent v3 (Cart + Planner + Validator, backend/app/services/agent_*.py): which clients it is ON for when
# Client.agent_v3_enabled is NULL ("1" = client 1 only, "*" = all, empty = none). The planner model:
# AGENT_V3_CLIENT_IDS=1
# LLM_MODEL_PLANNER=openai/gpt-oss-120b
# A greeting on a cart idle this many hours gets the cart recap + [Continue / New order / Browse]; fresher carts are continued in place.
# AGENT_GREETING_STALE_HOURS=6
# No summary upsell once the cart is worth more than this (₹); a client row may carry its own `upsell_max_cart_total`.
# AGENT_UPSELL_MAX_CART_TOTAL=10000
# 1 = the TURN block also lists every SQL statement of the turn in order (diagnosing round trips on a remote database).
# TURN_TRACE_SQL=
# Spelling-tolerant catalogue words ("lahemgha" → Lehenga): minimum rapidfuzz ratio (0-100).
# AGENT_FUZZY_MIN_RATIO=80

# Webhook: answer Meta with 200 at once and process the message in a background task (set false to process inline).
# WEBHOOK_BACKGROUND_PROCESSING=true

# ── v1.6 (conv=60: payment images, Groq 429) ────────────────────────────────────────────────────────────────────────
# If the planner model answers 429 / 5xx / times out, this model is called AT ONCE (no sleep); both failing → a deterministic answer.
# LLM_MODEL_PLANNER_FALLBACK=openai/gpt-oss-20b
# Client-side token bucket per model, JSON {"model": {"tpm": tokens/min, "rpm": requests/min}} (default = Groq free/on_demand: 8000 TPM, 30 RPM).
# Raise with the plan (Groq Developer tier); a model with no entry is unlimited. The provider's x-ratelimit-* headers tighten it at run time.
# LLM_RATE_LIMITS={"openai/gpt-oss-120b":{"tpm":8000,"rpm":30},"openai/gpt-oss-20b":{"tpm":8000,"rpm":30}}
# LLM_RATE_LIMIT_WAIT_SECONDS=2.0
# Recent payment instructions bias an unclear image to "payment screenshot" for this many minutes.
# PAYMENT_PROOF_PRIOR_MINUTES=60
# Images within this many seconds of the last image reply get no reply of their own (one answer per burst).
# PAYMENT_IMAGE_BATCH_SECONDS=60
# "This is the payment" re-reads the customer's unfiled images of the last N minutes.
# PAYMENT_RECLASSIFY_WINDOW_MINUTES=30
# "Sorry, I can't open that type of message" is sent once per sender per this many minutes.
# UNSUPPORTED_NOTICE_MINUTES=10
# A quantity above this is confirmed first ("Did you mean 150?").
# AGENT_QTY_SANE_MAX=100

# ── v1.7 ─────────────────────────────────────────────────────────────────────
# DB_POOL_SIZE=10                      # asyncpg pool (+ DB_MAX_OVERFLOW=20); sessions release their connection before LLM / vision / WhatsApp calls
# ORDER_EDIT_WINDOW_MINUTES=30         # a just-confirmed, still-unpaid order can be edited ("1 black and 1 grey") for this long
# PICKER_AUTO_ATTACH_RECENT_MINUTES=30 # no readable amount: attach the screenshot to the newest unpaid order when its instructions are this recent …
# PICKER_AUTO_ATTACH_OTHERS_OLDER_HOURS=6   # … and every other unpaid order's instructions are older than this; otherwise ask
# IMAGE_BLANK_MAX_LUMA=24              # a picture whose brightest pixel is below this (0-255) is "too dark to read"
# LOOP_WATCHDOG=1                      # 0 = no LOOP_BLOCKED / LOOP_STALL logging;  ASYNCIO_DEBUG=0 disables asyncio debug mode in development
