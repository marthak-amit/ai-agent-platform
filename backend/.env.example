# ─────────────────────────────────────────────────────────────────
# AI Agent Platform — Environment Variables
#
# Copy this file to .env and fill in real values before running.
# Never commit .env — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# asyncpg driver is added automatically; write plain postgresql:// here.
DATABASE_URL=postgresql://user:password@localhost:5432/ai_agent_db

# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq — all conversational replies, classifiers and vision run here.
GROQ_API_KEY=
# Model ids (defaults live in app/config.py). Verify what your key can use with:
#   python scripts/check_llm_models.py
# LLM_MODEL_VISION= (empty) disables the image-matching path.
# The old CLASSIFY_MODEL / REPLY_MODEL variables are no longer read — delete them.
# LLM_MODEL_REPLY=
# LLM_MODEL_CLASSIFIER=
# LLM_MODEL_VISION=
# LLM_MODEL_STT=
# LLM_MODEL_REPLY_FALLBACKS=

# Google Gemini API key — no longer used, kept for reference
GEMINI_API_KEY=

# Meta / WhatsApp Cloud API — Meta Developer Console → App → WhatsApp → Configuration
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Instagram (optional — only needed for Growth / Pro plan features)
# Per-client tokens live on clients.instagram_access_token (checked at startup via graph.instagram.com/me,
# refreshed weekly). This global token is only a fallback still used by IG sends / media download.
INSTAGRAM_ACCESS_TOKEN=

# Meta app credentials for the self-serve "Connect Instagram" OAuth flow
# (Meta Developer Console → App → Settings → Basic). META_APP_SECRET above
# is reused as the OAuth client secret — do not duplicate it.
META_APP_ID=
META_OAUTH_REDIRECT_URI=https://api.yourdomain.com/integrations/instagram/callback
# Scopes requested during the OAuth flow (Facebook Login for Business):
# instagram_basic, instagram_manage_messages, pages_show_list, pages_manage_metadata

# Razorpay (optional — only needed for payment features)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# This backend's own public HTTPS URL (e.g. Railway's assigned domain).
# Used to build fully-qualified invoice PDF links that WhatsApp's API can
# fetch. Leave unset in local dev — invoice documents just won't be
# fetchable by WhatsApp until this is set.
BACKEND_PUBLIC_URL=

# Public base URL of the hosted shop/catalogue pages, used in customer-facing
# catalogue links (legacy name CATALOGUE_BASE_URL is still read as a fallback).
PUBLIC_SHOP_BASE_URL=https://agentlyai.in/shop

# JWT signing secret — use a long random string in production. The app REFUSES
# TO START if ENVIRONMENT != development and this is still the default.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Admin panel key — sent as X-Admin-Key header to /admin/* endpoints
ADMIN_SECRET_KEY=change-me-admin-secret

# AgentlyAI team's own WhatsApp number (E.164, no '+'), e.g. 919876543210.
# Notified on new "Book a Demo" leads from the marketing site. Leave unset
# to skip the notification entirely — the lead is still saved either way.
INTERNAL_LEAD_NOTIFY_NUMBER=

# Cloudflare R2 (S3-compatible) — product/catalogue image storage.
# Dashboard: https://dash.cloudflare.com → R2 Object Storage
# Leave unset to fall back to local disk storage in dev.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
# Public base URL for the bucket once public access is enabled (bucket →
# Settings → Public access → either the r2.dev URL or a connected custom
# domain), e.g. https://pub-xxxx.r2.dev or https://media.yourdomain.com.
# Required for uploaded images to be fetchable by WhatsApp/Instagram.
R2_PUBLIC_BASE_URL=

# LLM cost tracking (llm_usage table). Prices are USD per 1M tokens as [input, output] —
# verify against the provider's pricing page. Models not listed use the default rate.
# USD_INR=83
# LLM_PRICE_USD_PER_1M={"openai/gpt-oss-20b": [0.075, 0.30]}
# LLM_STT_USD_PER_HOUR=0.04

# LLM intent router (ROUTER_V2): front door for non-slot messages. Which clients it is ON for
# when Client.router_v2_enabled is NULL: comma-separated client ids, "*" = all, empty = none.
# ROUTER_V2_CLIENT_IDS=1
# ROUTER_CONFIDENCE_THRESHOLD=0.5
